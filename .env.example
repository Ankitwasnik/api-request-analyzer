# Copy to .env and adjust. docker compose reads this file from the repo root;
# the producer loads it too (real environment variables take precedence).

# --- Postgres container (docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=app_db
POSTGRES_PORT=5432

# --- Producer connection ---
PRODUCER_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# --- Producer task ---
# once | continuous
PRODUCER_MODE=once
# RFC3339 time of the first row; may be in the past. Empty = now.
PRODUCER_START_TIME=2026-08-01T00:00:00Z

# once mode: row count, spread evenly from start to end (end empty = now)
PRODUCER_ROWS=100000
PRODUCER_END_TIME=

# continuous mode: rows per simulated second; duration 0 = run forever (e.g. 24h)
PRODUCER_RATE=100
PRODUCER_DURATION=0

# --- Data shape ---
PRODUCER_TENANTS=50
PRODUCER_USERS=100000
PRODUCER_BATCH_SIZE=5000
# 0 = random seed. Keep tenants/users/seed fixed across runs into the same table.
PRODUCER_SEED=0
PRODUCER_CREATE_TABLE=true

# --- ClickHouse container (docker-compose.yml) ---
CLICKHOUSE_DB=app_db
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# --- CDC users created by scripts/*-setup.sh ---
AIRBYTE_PG_USER=
AIRBYTE_PG_PASSWORD=
AIRBYTE_PG_SLOT=airbyte_slot
AIRBYTE_PG_PUBLICATION=airbyte_publication
AIRBYTE_CH_USER=
AIRBYTE_CH_PASSWORD=

# --- Airbyte (scripts/airbyte-*.sh) ---
AIRBYTE_URL=http://localhost:8000
# Airbyte runs inside a Kubernetes cluster in Docker; this reaches services published on the host.
AIRBYTE_SOURCE_HOST=host.docker.internal
AIRBYTE_DESTINATION_HOST=host.docker.internal
# 1 = abctl --low-resource-mode (2 CPUs / 8 GB)
AIRBYTE_LOW_RESOURCE=0
AIRBYTE_SOURCE_NAME=Postgres
AIRBYTE_DESTINATION_NAME=ClickHouse
AIRBYTE_CONNECTION_NAME=Postgres → ClickHouse
# manual | a Quartz cron expression (UTC), e.g. every 15 minutes
AIRBYTE_SCHEDULE=0 0/15 * * * ?
# Airbyte API sync mode: incremental_deduped_history | incremental_append | full_refresh_overwrite | full_refresh_append
AIRBYTE_SYNC_MODE=incremental_deduped_history
# Optional: skip reading credentials from `abctl local credentials`
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# --- Benchmark: identical resource limits for both databases ---
DB_CPUS=4
DB_MEMORY=3g
